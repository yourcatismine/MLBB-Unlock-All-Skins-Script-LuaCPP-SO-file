




ninja_required_version = 1.5



CONFIGURATION = RelWithDebInfo



include CMakeFiles/rules.ninja



cmake_ninja_workdir = C$:/Users/User/Downloads/skinhook/build/



build cmake_object_order_depends_target_skinhook: phony || .

build CMakeFiles/skinhook.dir/src/main_minimal.cpp.o: CXX_COMPILER__skinhook_unscanned_RelWithDebInfo C$:/Users/User/Downloads/skinhook/src/main_minimal.cpp || cmake_object_order_depends_target_skinhook
  DEFINES = -Dskinhook_EXPORTS
  DEP_FILE = CMakeFiles\skinhook.dir\src\main_minimal.cpp.o.d
  FLAGS = -DANDROID -fdata-sections -ffunction-sections -funwind-tables -fstack-protector-strong -no-canonical-prefixes -D_FORTIFY_SOURCE=2 -Wformat -Werror=format-security -fexceptions -frtti -stdlib=libc++ -O2 -g -DNDEBUG -std=gnu++17 -fPIC
  OBJECT_DIR = CMakeFiles\skinhook.dir
  OBJECT_FILE_DIR = CMakeFiles\skinhook.dir\src





build libskinhook.so: CXX_SHARED_LIBRARY_LINKER__skinhook_RelWithDebInfo CMakeFiles/skinhook.dir/src/main_minimal.cpp.o
  LANGUAGE_COMPILE_FLAGS = -DANDROID -fdata-sections -ffunction-sections -funwind-tables -fstack-protector-strong -no-canonical-prefixes -D_FORTIFY_SOURCE=2 -Wformat -Werror=format-security -fexceptions -frtti -stdlib=libc++ -O2 -g -DNDEBUG
  LINK_FLAGS = -Wl,--build-id=sha1 -Wl,--no-rosegment -Wl,--no-undefined-version -Wl,--fatal-warnings -Wl,--gc-sections -Qunused-arguments -Wl,--no-undefined
  LINK_LIBRARIES = -llog  -ldl   -static-libstdc++ -latomic -lm
  OBJECT_DIR = CMakeFiles\skinhook.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  SONAME = libskinhook.so
  SONAME_FLAG = -Wl,-soname,
  TARGET_FILE = libskinhook.so
  TARGET_PDB = skinhook.so.dbg



build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\User\Downloads\skinhook\build && C:\Strawberry\c\bin\cmake.exe -E echo "No interactive CMake dialog available.""
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util



build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D C:\Users\User\Downloads\skinhook\build && C:\Strawberry\c\bin\cmake.exe --regenerate-during-build -SC:\Users\User\Downloads\skinhook -BC:\Users\User\Downloads\skinhook\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


build skinhook: phony libskinhook.so




build all: phony libskinhook.so




